seed = 1

model solid_mechanics_model_cohesive [

  material elastic [
    name = bulk
    rho = 3900.0
    E = 370000000000
    nu = 0.
    finite_deformation = false
  ]

  material cohesive_linear [
    name = cohesive
    sigma_c = 262000000 uniform [0, 1000000]
    G_c = 50.
    beta = 0.
    penalty = 0.
  ]

]


user parameters [
  bar_length = 0.005
  number_elements = 500
  strain_rate = 10000
  max_time = 2e-6

  cohesive_energy_tolerance = 1e-4
  stable_steps = 10

  dump_freq = 1
  output_dir = ../data/test_czm
  output_file = energies.out
  fragment_file = fragments.out
]